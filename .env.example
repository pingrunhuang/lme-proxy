# lme-proxy environment. Copy to .env and edit. Do not commit .env.

# YAML feed config (112 realtime + 612 refresh + 614 trade replay).
LME_CONFIG=config/lme.yaml

# Optional TradableInstrumentID -> TAP-style symbol map (YAML or JSON).
# Example entry: 123456: LME:F:NI:3M
LME_SYMBOL_MAP=config/symbols.yaml

# Override the YAML network.interface_ip for live multicast join.
# Required for live mode; must be the IPv4 of the NIC that receives the feed.
# LME_INTERFACE_IP=10.0.0.10

# Optional classic PCAP of UDP payloads (takes precedence over live join).
# LME_PCAP=/path/to/lme.pcap

# Startup subscriptions attributed to client_id=proxy / strategy_id=startup.
# Comma-separated TAP symbols or raw TradableInstrumentID values.
# LME_SYMBOLS=LME:F:NI:3M

# TRACE, DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# Use DEBUG on the quote server to trace each multicast datagram and 112 sync steps.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_BACKUP_COUNT=30

# Next free ports after fiu-proxy 5615/5616.
ZMQ_BIND_HOST=0.0.0.0
ZMQ_PUB_PORT=5625
ZMQ_REP_PORT=5626
ZMQ_PUBLISH_QUEUE_SIZE=100000

# Downstream example script / engine:
# LME_PROXY_HOST=127.0.0.1
# ENABLE_LME=true
